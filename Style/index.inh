    *{
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    scroll-behavior: smooth;
}
:root{
    --primary-color-purple: rgb(67, 0, 67);
}
/* *header{
    background-image: url(../IMG/background-header.jpg);
    background-size: cover;
    min-height: 30rem;
    padding: 1rem;
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
    color: white;
}
.top-header{
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 3rem;
}
.box-menu{
    padding: 1rem;
    display: flex;
    gap: 3px;
    position: relative;
}
.box-menu h3{
    cursor: default;
}
.style-menu{
    height: 0rem;
    min-width: 4.2rem;
    position: absolute;
    top: 2.2rem;
    left: 1.1rem;
    transition: 1s ease;
    overflow: hidden;
}
.nav-menu{
    list-style: none;
    padding-top: 10px;
}
.menu-child{
    margin-bottom: 1rem;
}
.menu-child a{
    text-decoration: none;
    color: white;
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
    transition: .4s ease;
}
.menu-child a:hover{
    color: var(--primary-color-purple);
}
.box-menu img{
    width: 18px;
    position: relative;
}
.box-headerVacant{
}
.box-logo{
    padding: 1rem;
    transition: .4s ease;
    cursor: default;
}
.box-logo h3:hover{
    color: var(--primary-color-purple);
}
.buttum-header{
    display: flex;
}
.box-title{
    padding: 1rem;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}
.box-title h2{
    font-size: 5rem;
}
.box-title p{
    color: rgb(204, 204, 204);
}
.box-titleVacant{
}






main{
    font-family: 'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
    background-color: rgb(27, 27, 27);
}
.container-project{
    width: 100%;
    padding: 1rem;
}
.boxProject-title{
    width: 100%;
    padding: 1rem;
    margin-bottom: 2rem;
}
.boxProject-title h3{
    font-size: 2rem;
    color: white;
}
.boxProject-cards{
    width: 100%;
    padding: 1rem;
    display: flex;
    justify-content: space-around;
}
.project-card{
    background-color: black;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    border-radius: 1rem;
}
.boxImage-card{
    background-color: var(--primary-color-purple);
    padding: 5px;
    border-radius: 1rem;
}
.boxImage-card img{
    width: 25rem;
    border-radius: 1rem;
    transition: 1s ease;
}
.boxImage-card:hover img{
    scale: 1.02;
}
.boxTitle-card{
    padding-left: 1rem;
    color: white;
}
.boxDescription-card{
    padding-left: 1rem;
}
.boxDescription-card span{
